* text=auto

# Keep POSIX scripts and audited license bytes consistent on both platforms.
*.sh text eol=lf
licenses/*.txt text eol=lf

# Locale checks compare generated UTF-8/LF bytes, including after checkout.
botw_companion/i18n/*.json text eol=lf
botw_companion/locales/** text eol=lf
botw_companion/web/i18n.js text eol=lf

# Binary resources.
*.dll binary
*.dmg binary
*.exe binary
*.icns binary
*.ico binary
*.png binary
*.webp binary
